            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT"/>
            <setting key="standby temperature">100</setting>
            <setting key="heated bed temperature">90</setting>
            <setting key="build volume temperature">0</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">290</setting>
                <cura:setting key="material_flow">95</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.09</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">55</setting>
                <cura:setting key="line_width">0.4</cura:setting>
                <cura:setting key="cool_fan_speed_max">100</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">20</cura:setting> 
