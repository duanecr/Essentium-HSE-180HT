                <cura:setting key="material_flow">96.3</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.015</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">45</setting> 
