<?xml version='1.0' encoding='UTF-8'?>
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Essentium</brand>
            <material>ESD Safe</material>
            <color>Black</color>
            <label>PCTG Z</label>
        </name>
        <color_code>#3cb44b</color_code>
        <GUID>ab94b4f7-a02a-4d71-835a-58aafbb16f06</GUID>
        <version>27</version>
        <description>Essentium PCTG is an easy-to-use material with incredible surface finish, superior toughness, and chemical resistance — use it just like PETG. v1.1.0</description>
        <adhesion_info>We recommend Essentium Standard Bed Adhesive - Powered by Magigoo</adhesion_info>
    </metadata>
    <properties>
        <diameter>1.75</diameter>
        <density>1.23</density>
    </properties>
    <settings>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE180HT"/>
            <setting key="standby temperature">160</setting>
            <setting key="heated bed temperature">80</setting>
            <setting key="build volume temperature">0</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">300</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.125</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting>
                <cura:setting key="line_width">0.44</cura:setting>
                <cura:setting key="cool_fan_speed_max">100</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">20</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">0.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.05</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">285</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.041</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting> 
                <cura:setting key="line_width">0.96</cura:setting>
                <cura:setting key="cool_fan_speed_max">70</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">0.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.14</cura:setting>
            </hotend>
        </machine>
