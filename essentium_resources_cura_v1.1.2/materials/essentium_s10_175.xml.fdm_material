<?xml version='1.0' encoding='UTF-8'?>
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Essentium</brand>
            <material>Support</material>
            <color>Natural</color>
            <label>S10 Support</label>
        </name>
        <color_code>#a9a9a9</color_code>
        <GUID>bb94b4f7-a12a-4d71-835a-58baf1b17f06</GUID>
        <version>27</version>
        <description>Essentium Support S10 is our entry-level water soluble support material that is compatible with our HTN, PA, TPU, and PLA material families. Support S10 allows users to print complex designs on our HSE IDEX printers, then wash away the supports in warm tap water. Users no longer have to worry about caustic water baths, detergent solutions, or the hassle of disposing hazardous waste. v1.1.0</description>
        <adhesion_info></adhesion_info>
    </metadata>
    <properties>
        <diameter>1.75</diameter>
        <density>1.13</density>
    </properties>
    <settings>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT"/>
            <setting key="standby temperature">100</setting>
            <setting key="heated bed temperature">70</setting>
            <setting key="build volume temperature">0</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">265</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.045</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting>
                <cura:setting key="line_width">0.44</cura:setting>
                <cura:setting key="cool_fan_speed_max">30</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2</setting>
                <cura:setting key="retraction_extra_prime_amount">0.022</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.22</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">265</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.02</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting> 
                <cura:setting key="line_width">0.88</cura:setting>
                <cura:setting key="cool_fan_speed_max">30</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2</setting>
                <cura:setting key="retraction_extra_prime_amount">0.062</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.616</cura:setting>
            </hotend>

        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT_dvt3ws"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i_dvt3ws"/>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">265</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.045</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting>
                <cura:setting key="line_width">0.44</cura:setting>
                <cura:setting key="cool_fan_speed_max">30</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2</setting>
                <cura:setting key="retraction_extra_prime_amount">0.022</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.22</cura:setting>
                <!--Purge settings-->  
                <cura:setting key="switch_extruder_retraction_amount">5</cura:setting>
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
                <cura:setting key="mold_width">5</cura:setting>
                <cura:setting key="mold_angle">5</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">265</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.02</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting> 
                <cura:setting key="line_width">0.88</cura:setting>
                <cura:setting key="cool_fan_speed_max">30</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2</setting>
                <cura:setting key="retraction_extra_prime_amount">0.062</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.616</cura:setting>
                <!--Purge settings-->  
                <cura:setting key="switch_extruder_retraction_amount">5</cura:setting>
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
                <cura:setting key="mold_width">5</cura:setting>
                <cura:setting key="mold_angle">5</cura:setting>
            </hotend>
        </machine>
    </settings>
</fdmmaterial>
