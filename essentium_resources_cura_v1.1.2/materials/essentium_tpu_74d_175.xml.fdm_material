<?xml version='1.0' encoding='UTF-8'?>
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Essentium</brand>
            <material>Flexible</material>
            <color>Black</color>
            <label>TPU 74D</label>
        </name>
        <color_code>#f58231</color_code>
        <GUID>de8ec441-239f-4ee1-9de3-f8bb8999525a</GUID>
        <version>27</version>
        <description>Essentium TPU 74D is the highest durometer ﬁlament in our broad ﬂexible portfolio. It is a no-warp drop-in replacement for ABS. It has excellent impact strength, tear strength, and abrasion resistance. v1.1.0</description>
        <adhesion_info>We recommend Essentium Flexible Bed Adhesive - Powered by Magigoo</adhesion_info>
    </metadata>
    <properties>
        <diameter>1.75</diameter>
        <density>1.2</density>
    </properties>
    <settings>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE180HT"/>
            <setting key="standby temperature">100</setting>
            <setting key="heated bed temperature">75</setting>
            <setting key="build volume temperature">0</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">270</setting>
                <cura:setting key="material_flow">99</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.062</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting>
                <cura:setting key="line_width">0.4</cura:setting>
                <cura:setting key="cool_fan_speed_max">70</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">False</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">False</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">270</setting>
                <cura:setting key="material_flow">99</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.062</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting> 
                <cura:setting key="line_width">0.84</cura:setting>
                <cura:setting key="cool_fan_speed_max">60</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">25</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">False</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">False</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.074</cura:setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT"/>
            <setting key="standby temperature">100</setting>
            <setting key="heated bed temperature">70</setting>
            <setting key="build volume temperature">0</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">265</setting>
                <cura:setting key="material_flow">99</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.062</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting>
                <cura:setting key="line_width">0.4</cura:setting>
                <cura:setting key="cool_fan_speed_max">70</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">280</setting>
                <cura:setting key="material_flow">99</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.062</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting> 
                <cura:setting key="line_width">0.84</cura:setting>
                <cura:setting key="cool_fan_speed_max">60</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">25</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.074</cura:setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT_dvt3ws"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i_dvt3ws"/>
            <hotend id="GenV 0.4mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
        </machine>
    </settings>
</fdmmaterial>
