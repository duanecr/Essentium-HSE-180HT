<?xml version='1.0' encoding='UTF-8'?>
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Essentium</brand>
            <material>High Temperature</material>
            <color>Natural</color>
            <label>PEEK</label>
        </name>
        <color_code>#d2b48c</color_code>
        <GUID>8ae212db-caf8-48ce-bd53-39dd613e0c9a</GUID>
        <version>27</version>
        <description>Essentium PEEK is the highest performance material in our broad material portfolio. In addition to best-in-class printability, it has excellent thermal and chemical resistance. Essentium PEEK boasts outstanding strength, stiffness, and impact properties and is inherently flame resistant. v1.1.0</description>
        <adhesion_info>We recommend Essentium HT Bed Adhesive - Powered by Magigoo</adhesion_info>
    </metadata>
    <properties>
        <diameter>1.75</diameter>
        <density>1.31</density>
    </properties>
    <settings>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE180HT"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT"/>
            <setting key="standby temperature">100</setting>
            <setting key="heated bed temperature">160</setting>
            <setting key="build volume temperature">180</setting>
            <hotend id="GenVI 0.4mm">
                <setting key="hardware compatible">yes</setting>
                <!--Core settings-->  
                <setting key="print temperature">465</setting>
                <cura:setting key="material_flow">90</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.055</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting>
                <cura:setting key="line_width">0.44</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0</cura:setting>
            </hotend>
            <hotend id="GenVI 0.8mm">
                <setting key="hardware compatible">yes</setting>
                <!--Core settings-->  
                <setting key="print temperature">450</setting>
                <cura:setting key="material_flow">94</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.032</cura:setting>   
                <cura:setting key="cool_fan_enabled">False</cura:setting>
                <setting key="print cooling">0</setting> 
                <cura:setting key="line_width">0.8</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.4mm">
                <setting key="hardware compatible">no</setting>
            </hotend>            
            <hotend id="GenV 0.8mm">
                <setting key="hardware compatible">no</setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT_dvt3ws"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i_dvt3ws"/>
            <hotend id="GenVI 0.4mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
            <hotend id="GenVI 0.8mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
        </machine>
    </settings>
</fdmmaterial>
