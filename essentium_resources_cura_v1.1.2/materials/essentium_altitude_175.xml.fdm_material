                <setting key="print cooling">30</setting>
                <cura:setting key="line_width">0.48</cura:setting>
                <cura:setting key="cool_fan_speed_max">45</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">6.5</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">4</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.24</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">310</setting>
                <cura:setting key="material_flow">92</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.034</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">5</setting> 
                <cura:setting key="line_width">0.88</cura:setting>
                <cura:setting key="cool_fan_speed_max">45</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">6.5</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2</setting>
                <cura:setting key="retraction_extra_prime_amount">2.5</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.1</cura:setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT_dvt3ws"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i_dvt3ws"/>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">300</setting>
                <cura:setting key="material_flow">96</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.039</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting>
                <cura:setting key="line_width">0.48</cura:setting>
                <cura:setting key="cool_fan_speed_max">45</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">6.5</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">4</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.24</cura:setting>
                <!--Purge settings-->  
                <cura:setting key="switch_extruder_retraction_amount">5</cura:setting>
                <cura:setting key="material_flush_purge_length">40</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
                <cura:setting key="mold_width">10</cura:setting>
                <cura:setting key="mold_angle">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">290</setting>
                <cura:setting key="material_flow">95</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.034</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">30</setting> 
                <cura:setting key="line_width">1.23</cura:setting>
                <cura:setting key="cool_fan_speed_max">45</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">6.5</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">1</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">4</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.615</cura:setting>
                <!--Purge settings-->  
                <cura:setting key="switch_extruder_retraction_amount">0</cura:setting>
                <cura:setting key="material_flush_purge_length">30</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
                <cura:setting key="mold_width">10</cura:setting>
                <cura:setting key="mold_angle">5</cura:setting>
