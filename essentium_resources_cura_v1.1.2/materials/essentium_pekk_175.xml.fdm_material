<?xml version='1.0' encoding='UTF-8'?>
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Essentium</brand>
            <material>High Temperature</material>
            <color>Natural</color>
            <label>PEKK</label>
        </name>
        <color_code>#c48b18</color_code>
        <GUID>a99b585d-bb95-4f1b-8551-ee4016008169</GUID>
        <version>27</version>
        <description>Essentium polyetherketoneketone (PEKK) filament shares most of the performance attributes of PEEK: strong chemical resistance, high dimensional stability, and high temperature resistance. PEKK maintains the flame smoke toxicity ratings for FAR compliance and offers excellent resistance to chemical attack. v1.1.0</description>
        <adhesion_info>We recommend Essentium HT Bed Adhesive - Powered by Magigoo</adhesion_info>
    </metadata>
    <properties>
        <diameter>1.75</diameter>
        <density>1.27</density>
    </properties>
    <settings>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE180HT"/>
            <setting key="standby temperature">200</setting>
            <setting key="heated bed temperature">140</setting>
            <setting key="build volume temperature">140</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">445</setting>
                <cura:setting key="material_flow">100</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.1</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">20</setting>
                <cura:setting key="line_width">0.4</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">False</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">0.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">False</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.05</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">400</setting>
                <cura:setting key="material_flow">92</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.028</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">20</setting> 
                <cura:setting key="line_width">0.8</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">False</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">False</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.112</cura:setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT"/>
            <setting key="standby temperature">200</setting>
            <setting key="heated bed temperature">160</setting>
            <setting key="build volume temperature">160</setting>
            <hotend id="GenV 0.4mm">
                <!--Core settings-->  
                <setting key="print temperature">445</setting>
                <cura:setting key="material_flow">86</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.01</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">5</setting>
                <cura:setting key="line_width">0.4</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">0.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.1</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <!--Core settings-->  
                <setting key="print temperature">400</setting>
                <cura:setting key="material_flow">87</cura:setting>
                <cura:setting key="material_linear_advance_enable">True</cura:setting>
                <cura:setting key="material_linear_advance_factor">0.028</cura:setting>   
                <cura:setting key="cool_fan_enabled">True</cura:setting>
                <setting key="print cooling">5</setting> 
                <cura:setting key="line_width">0.8</cura:setting>
                <cura:setting key="cool_fan_speed_max">0</cura:setting>
                <cura:setting key="cool_min_layer_time_fan_speed_max">15</cura:setting> 
                <cura:setting key="infill_overlap">1</cura:setting> 
                <!--Ooze control settings-->  
                <cura:setting key="retraction_enable">True</cura:setting> 
                <setting key="retraction speed">45</setting>
                <setting key="retraction amount">2.5</setting>
                <cura:setting key="retraction_extra_prime_amount">0</cura:setting>
                <cura:setting key="wall_0_wipe_dist">0</cura:setting>
                <cura:setting key="coasting_enable">True</cura:setting>
                <cura:setting key="coasting_speed">100</cura:setting>       
                <cura:setting key="coasting_volume">0.112</cura:setting>
            </hotend>
        </machine>
        <machine>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE240HT_dvt3ws"/>
            <machine_identifier manufacturer="Essentium Inc." product="essentium_HSE280i_dvt3ws"/>
            <hotend id="GenV 0.4mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
            <hotend id="GenV 0.8mm">
                <cura:setting key="material_flush_purge_length">50</cura:setting>       
                <cura:setting key="material_flush_purge_speed">180</cura:setting>
                <cura:setting key="material_surface_energy">0</cura:setting>
            </hotend>
        </machine>
    </settings>
</fdmmaterial>
